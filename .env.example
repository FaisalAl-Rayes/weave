# =============================================================
# Core — Kubernetes datasource
# =============================================================
KUBERNETES_API_URL=https://api.your-cluster.example.com:6443
KUBERNETES_TOKEN=your-bearer-token

# =============================================================
# KubeArchive — historical Kubernetes resources
# =============================================================
KUBEARCHIVE_URL=https://kubearchive.your-cluster.example.com
KUBEARCHIVE_TOKEN=your-bearer-token

# =============================================================
# Splunk (logs)
# =============================================================
SPLUNK_URL=https://splunk.example.com
SPLUNK_USERNAME=your-username
SPLUNK_PASSWORD=your-password

# =============================================================
# Optional datasources
# =============================================================

# Prometheus (metrics)
PROMETHEUS_URL=https://prometheus.example.com
PROMETHEUS_AUTH_TYPE=bearer  # bearer | basic | oauth2 | none
PROMETHEUS_TOKEN=your-token
# Optional: comma-separated key:value pairs
# PROMETHEUS_HEADERS=X-Scope-OrgID:your-tenant

# Tempo (traces)
TEMPO_URL=https://tempo.example.com
TEMPO_AUTH_TYPE=bearer
TEMPO_TOKEN=your-token
# TEMPO_HEADERS=X-Scope-OrgID:your-tenant

# SumoLogic (logs / audit)
SUMOLOGIC_URL=https://api.sumologic.com
SUMOLOGIC_ACCESS_ID=your-access-id
SUMOLOGIC_ACCESS_KEY=your-access-key

# Webhook (generic data — any JSON API)
# WEBHOOK_URL=https://your-api.example.com
# WEBHOOK_AUTH_TYPE=apikey  # bearer | basic | apikey | none
# WEBHOOK_API_KEY=your-api-key
# WEBHOOK_API_KEY_HEADER=X-API-Key
